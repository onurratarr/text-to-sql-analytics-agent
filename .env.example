# Offline mock by default. Set SQL_MODEL_BACKEND=openai to use any OpenAI-compatible chat endpoint.
SQL_MODEL_BACKEND=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Where the generated warehouse file goes (default: ./warehouse/juniper.duckdb)
WAREHOUSE_PATH=
